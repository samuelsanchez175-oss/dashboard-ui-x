# Copy to `.env` or `.env.local` (see README). Values are read only on the dev / preview Node server.
# Never commit real secrets.
#
# Every key below is also documented in the dashboard at Dev → Settings & API, where you
# can store values in browser-local scratch instead of this file (sent per-request as
# `x-user-key-*` headers; a header wins over env). Exceptions: server-path keys
# (FFMPEG_PATH / YT_DLP_PATH / YOUTUBE_AUDIO_BACKEND) and `VITE_*` keys are env-only,
# and the Tesla OAuth pair is browser-scratch-only (see below).

# --- Google (generic Cloud / API key) — BFF: GET /api/google/health ---
# YouTube uses YOUTUBE_API_KEY first, then falls back to GOOGLE_API_KEY if set.
GOOGLE_API_KEY=

# --- Gemini (Google AI Studio) — GET /api/gemini/health POST /api/gemini/ping POST /api/gemini/generate ---
GEMINI_API_KEY=

# Optional separate Gemini quota for Harmony Stack → Client Projects
# (POST /api/harmony/client-projects/build-prompt). Empty → falls back to GEMINI_API_KEY.
HARMONY_CLIENT_PROJECTS_AI_KEY=

# --- YouTube Data API v3 — GET /api/youtube/channel GET /api/youtube/search ---
YOUTUBE_API_KEY=

# Used when GET /api/youtube/channel has no ?handle=...
AGENT_FARM_YOUTUBE_CHANNEL_ID=

# --- Configured RSS feeds — GET /api/rss [?url=exact-match-from-list] [&limit=30] ---
# Comma-separated HTTPS feed URLs.
RSS_FEED_URLS=

# --- OpenAI-compatible — GET /api/openai/ping  POST /api/openai/generate ---
# fetchAi('openai', …) posts to /api/openai/generate (default model gpt-4o-mini;
# pass { model } in the body to override). Set OPENAI_BASE_URL for Azure /
# OpenRouter / other OpenAI-compatible gateways. If VITE_AI_GATEWAY_URL is set,
# the call is routed there instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Anthropic — POST /api/anthropic/generate ---
# fetchAi('anthropic', …) posts to /api/anthropic/generate (model claude-opus-4-8;
# pass { cache: true } to enable prompt caching on the system prompt). The key is
# read from this file or forwarded as `x-user-key-anthropic-api-key` from Settings.
# If VITE_AI_GATEWAY_URL is set, the call is routed there instead.
ANTHROPIC_API_KEY=

# --- Tesla Fleet OAuth (browser scratch ONLY — not read from this file) ---
# TESLA_CLIENT_ID / TESLA_CLIENT_SECRET are read exclusively from browser-local
# scratch (Dev → Settings & API → Tesla Fleet) and forwarded as `x-user-key-tesla-*`
# headers by the OAuth helper pages. Setting them here has no effect by design.

# --- Mixing / YouTube audio — POST /api/mixing/youtube-audio (server-only; no header fallback) ---
# Empty values fall back to Homebrew paths (/opt/homebrew/bin, /usr/local/bin), then $PATH.
FFMPEG_PATH=
YT_DLP_PATH=
# auto | yt2mp3 | ytdlp — backend selection (default auto: yt2mp3-style flow first, then yt-dlp + ffmpeg).
YOUTUBE_AUDIO_BACKEND=

# --- Vercel AI Gateway (optional, client-inlined) ---
# Opt-in. When set, `fetchAi(provider, body)` POSTs to `${VITE_AI_GATEWAY_URL}/<provider>`
# instead of the local dev BFF, forwarding the same `x-user-key-*` headers.
# Leave empty to use the local dev BFF routes (gemini → /api/gemini/generate,
# openai → /api/openai/generate, anthropic → /api/anthropic/generate).
# Vite-inlined at build time — restart `npm run dev` after editing.
VITE_AI_GATEWAY_URL=

# --- Tesla Vehicle Command — virtual key public-key hosting domain ---
# When you deploy the dashboard to a domain, set this so the Tesla pairing flow
# can link to `https://www.tesla.com/_ak/<domain>`. The domain must host the
# generated public key at `/.well-known/appspecific/com.tesla.3p.public-key.pem`
# (the BFF writes that file to `public/` when you generate a key, and Vite +
# Vercel serve `public/` at the root automatically).
# Vite-inlined — restart `npm run dev` after editing.
VITE_TESLA_VIRTUAL_KEY_DOMAIN=

# --- Client keys (Vite-inlined at build time; restart `npm run dev` after editing) ---

# Referrer-restricted Google Maps Embed key — Tesla trip map (TeslaMockVisuals / google-maps-trips).
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Optional remote stem-splitter endpoint — Tools → Stem splitter HTTP stub.
VITE_STEM_SERVICE_URL=

# note-detector-2 FastAPI base URL (Demucs + basic-pitch). Defaults to http://localhost:8000
# when empty — correct for `cd note-detector-2 && docker compose up`.
VITE_ND2_API=

# Local LLM (Ollama / Gemma) for Rhyme Studio — base URL (e.g. http://localhost:11434),
# model id (e.g. gemma2:2b), and optional RAG manifest URL returning { "snippets": [...] }.
VITE_LOCAL_LLM_BASE_URL=
VITE_LOCAL_LLM_MODEL=
VITE_RAG_MANIFEST_URL=

# --- Projects re-audit + cross-env check-off sync ---
# ANTHROPIC_API_KEY (above) also powers the repeatable Opus project re-audit
# (scripts/build-projects-ai.mjs, used by the Projects → Refresh button / cron).
# Optional model override; defaults to claude-opus-4-8:
# ANTHROPIC_MODEL=claude-opus-4-8
#
# Cross-env check-off sync (scripts/sync-checkoffs.mjs, run by launchd — see scripts/PROJECT-SYNC.md).
# On localhost, ticking writes the vault note directly via the BFF. To also pick up check-offs made
# on Vercel, point this at ONE cloud store both Vercel and this Mac can reach; the endpoint must
# return JSON {"<taskId>": true|false}.
# CHECKOFF_STORE_URL=
# CHECKOFF_STORE_TOKEN=
