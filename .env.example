# Copy to `.env` or `.env.local` (see README). Values are read only on the dev / preview Node server.
# Never commit real secrets.

# --- Google (generic Cloud / API key) — BFF: GET /api/google/health ---
# YouTube uses YOUTUBE_API_KEY first, then falls back to GOOGLE_API_KEY if set.
GOOGLE_API_KEY=

# --- Gemini (Google AI Studio) — GET /api/gemini/health POST /api/gemini/ping POST /api/gemini/generate ---
GEMINI_API_KEY=

# --- YouTube Data API v3 — GET /api/youtube/channel GET /api/youtube/search ---
YOUTUBE_API_KEY=

# Used when GET /api/youtube/channel has no ?handle=...
AGENT_FARM_YOUTUBE_CHANNEL_ID=

# --- Configured RSS feeds — GET /api/rss [?url=exact-match-from-list] [&limit=30] ---
RSS_FEED_URLS=

# --- OpenAI-compatible — GET /api/openai/ping ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Anthropic (optional) ---
# Optional Anthropic API key. Forwarded as `x-user-key-anthropic-api-key` by
# `fetchAi()` so a future BFF route or AI Gateway can pick it up. Not consumed
# by any built-in `/api/*` route today — safe to leave empty.
ANTHROPIC_API_KEY=

# --- Vercel AI Gateway (optional, client-inlined) ---
# Opt-in. When set, `fetchAi(provider, body)` POSTs to `${VITE_AI_GATEWAY_URL}/<provider>`
# instead of the local dev BFF, forwarding the same `x-user-key-*` headers.
# Leave empty to keep the current behavior (gemini → /api/gemini/generate; openai
# and anthropic return a structured 501 until a BFF route is added).
# Vite-inlined at build time — restart `npm run dev` after editing.
VITE_AI_GATEWAY_URL=

# --- Tesla Vehicle Command — virtual key public-key hosting domain ---
# When you deploy the dashboard to a domain, set this so the Tesla pairing flow
# can link to `https://www.tesla.com/_ak/<domain>`. The domain must host the
# generated public key at `/.well-known/appspecific/com.tesla.3p.public-key.pem`
# (the BFF writes that file to `public/` when you generate a key, and Vite +
# Vercel serve `public/` at the root automatically).
# Vite-inlined — restart `npm run dev` after editing.
VITE_TESLA_VIRTUAL_KEY_DOMAIN=
