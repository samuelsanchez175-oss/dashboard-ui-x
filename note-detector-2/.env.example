# Copy to `.env` and adjust as needed. `docker-compose.yml` overrides the redis
# hosts to use the compose-network DNS name, so the values here only matter when
# you run the app outside docker.

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# URL the API embeds in /status responses for the client to download from.
API_BASE_URL=http://localhost:8000

# Demucs settings — "cpu" works everywhere; switch to "cuda" if you've wired a GPU.
DEMUCS_DEVICE=cpu
DEMUCS_MODEL=htdemucs
