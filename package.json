{
  "name": "ui-dashboard-x",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:persist": "pm2 startOrReload ecosystem.config.cjs",
    "dev:persist:stop": "pm2 delete ui-dashboard-x-vite",
    "dev:persist:logs": "pm2 logs ui-dashboard-x-vite",
    "bundle:bff": "node scripts/bundle-bff.mjs",
    "prebuild": "node scripts/genRecentEdits.mjs && npm run bundle:bff",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:visual": "playwright test",
    "refresh:codeburn": "node scripts/refresh-codeburn.mjs",
  "verify:localhost": "node scripts/verify-localhost.mjs",
    "verify:live": "VERIFY_REQUIRE_DEV=1 node scripts/verify-localhost.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "fast-xml-parser": "^5.7.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "music-metadata": "^11.12.3",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rhyming-part": "^2.1.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pm2": "^6.0.14",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
